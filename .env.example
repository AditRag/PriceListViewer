# Server port. The Vite development server proxies /api and /uploads here.
PORT=4000
# Supabase (place real values only in your ignored .env file)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Deployment only: URL of the separately deployed Express API, e.g. https://api.example.com
VITE_API_URL=
